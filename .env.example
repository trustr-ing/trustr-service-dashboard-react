DATABASE_URL=./data/dashboard.db
SESSION_SECRET=your-random-hex-64-characters-here
ORCHESTRATOR_API_URL=http://localhost:3002
# Optional fallback:
# ORCHESTRATOR_URL=http://localhost:3002
NEXT_PUBLIC_DEFAULT_RELAYS=wss://relay.primal.net,wss://relay.damus.io
# Orchestrator's TSM Assertions service pubkey (hex). Used by the
# Demo 1 "Export Results" feature when generating a kind 37572 TSM
# Subject Assertions request. Mirror the value of TSM_ASSERTIONS_PRIVKEY's
# derived pubkey in the orchestrator env.
NEXT_PUBLIC_ASSERTIONS_PUBKEY=
